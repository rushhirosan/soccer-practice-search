#!/usr/bin/env bash
#
# コミット前に秘密情報が含まれていないかチェック
# 有効化: git config core.hooksPath scripts/git-hooks
# または: cp scripts/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "🔍 コミット前チェックを実行中..."

ENV_FILES=$(git diff --cached --name-only | grep -E '\.(env|bak|backup)$' || true)
if [ -n "$ENV_FILES" ]; then
    echo "${RED}❌ エラー: 環境変数ファイルまたはバックアップファイルが含まれています${NC}"
    echo "$ENV_FILES"
    echo ""
    echo "${YELLOW}これらのファイルはコミットしないでください${NC}"
    echo "${YELLOW}.gitignore を確認してください${NC}"
    exit 1
fi

if git diff --cached | grep -qE 'AIza[0-9A-Za-z_-]{35}'; then
    echo "${RED}❌ エラー: Google APIキーが検出されました${NC}"
    echo ""
    echo "${YELLOW}APIキーをコミットしないでください${NC}"
    echo "${YELLOW}環境変数として管理してください${NC}"
    exit 1
fi

SECRET_REGEX=(
    'sk-[0-9A-Za-z]{32,}'
    'xox[baprs]-[0-9a-zA-Z-]{10,}'
    'ghp_[0-9A-Za-z]{36}'
)

for pattern in "${SECRET_REGEX[@]}"; do
    if git diff --cached | grep -qE -- "$pattern"; then
        echo "${RED}❌ エラー: 秘密情報のパターンが検出されました${NC}"
        echo "${YELLOW}パターン: $pattern${NC}"
        echo ""
        echo "${YELLOW}秘密情報をコミットしないでください${NC}"
        exit 1
    fi
done

# PEM 秘密鍵（unified diff の追加行に現れる +-----BEGIN … のみ。フック内の文字列と誤爆しない）
if git diff --cached | grep -qE '^\+-----BEGIN .+PRIVATE KEY'; then
    echo "${RED}❌ エラー: PEM 形式の秘密鍵らしき行が検出されました${NC}"
    echo ""
    echo "${YELLOW}秘密情報をコミットしないでください${NC}"
    exit 1
fi

echo "${GREEN}✅ チェック完了: 問題ありません${NC}"
exit 0
